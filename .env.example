# Copy to .env.local only when a later, explicit database test step needs it.
# Do not commit real Supabase/PostgreSQL credentials or personenbezogene Daten.
DATABASE_URL=

# Supabase Auth — public values (safe to expose in browser/server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Admin API — server-only, never NEXT_PUBLIC_
# Required for Benutzerverwaltung: inviteUserByEmail, deleteAuthUser
# Find this in: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=
